rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Connection test path
    match /test/{docId} {
      allow read: if true;
    }

    // BrainVault Canvas Notes, Workspaces & Stickies Snapshot
    match /vault_snapshots/{snapshotId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['workspaces', 'nodes'])
                            && request.resource.data.workspaces is list
                            && request.resource.data.nodes is list;
      allow delete: if false;
    }

    // API Keys Manager Configuration
    match /api_keys/{configId} {
      allow read: if true;
      allow create, update: if request.resource.data is map
                            && request.resource.data.keys().size() <= 25;
      allow delete: if false;
    }

    // Saved News & Blog Briefings
    match /saved_news/{storyId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'title'])
                            && isValidString(request.resource.data.id, 300)
                            && isValidString(request.resource.data.title, 1000);
      allow delete: if true;
    }

    // CISA KEV & 2020-2026 CVE / Malware Catalog
    match /cve_catalog/{cveId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['cveId', 'title'])
                            && isValidString(request.resource.data.cveId, 120)
                            && isValidString(request.resource.data.title, 1000);
      allow delete: if true;
    }

    // Isolated Multi-User Vaults
    match /user_vaults/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name'])
                            && isValidString(request.resource.data.id, 200)
                            && isValidString(request.resource.data.name, 300);
      allow delete: if true;
    }
  }
}
