{
  "entities": {
    "VaultSnapshot": {
      "title": "VaultSnapshot",
      "description": "Stores the complete BrainVault spatial canvas state including workspaces, notes (nodes), sticky memos, and links.",
      "type": "object",
      "properties": {
        "activeWorkspaceId": { "type": "string", "description": "Currently active workspace ID" },
        "workspaces": { "type": "array", "description": "Array of workspace objects" },
        "nodes": { "type": "array", "description": "Array of spatial concept note cards" },
        "stickies": { "type": "array", "description": "Array of sticky memos" },
        "links": { "type": "array", "description": "Array of node connection links" },
        "updatedAt": { "type": "number", "description": "Epoch timestamp in ms" }
      },
      "required": ["workspaces", "nodes"]
    },
    "ApiKeysConfig": {
      "title": "ApiKeysConfig",
      "description": "Stores API keys for NewsData.io, Currents, Mediastack, NewsAPI, Higgsfield, and RSS gateways.",
      "type": "object",
      "properties": {
        "newsdata_key": { "type": "string" },
        "currents_key": { "type": "string" },
        "mediastack_key": { "type": "string" },
        "newsapi_key": { "type": "string" },
        "higgsfield_key": { "type": "string" },
        "gnews_key": { "type": "string" },
        "reddit_user_agent": { "type": "string" },
        "rss2json_key": { "type": "string" },
        "techcrunch_token": { "type": "string" },
        "wired_key": { "type": "string" },
        "bbc_key": { "type": "string" },
        "updatedAt": { "type": "number" }
      }
    },
    "SavedNewsStory": {
      "title": "SavedNewsStory",
      "description": "Saved news article, CISA KEV alert, or threat intelligence briefing.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "source": { "type": "string" },
        "url": { "type": "string" },
        "publishedAt": { "type": "string" },
        "summary": { "type": "string" },
        "takeaways": { "type": "array" },
        "savedAt": { "type": "number" }
      },
      "required": ["id", "title"]
    },
    "CveCatalogRecord": {
      "title": "CveCatalogRecord",
      "description": "CISA Known Exploited Vulnerability (KEV) and 2020-2026 CVE/Malware record with tools used and 7 key intelligence points.",
      "type": "object",
      "properties": {
        "cveId": { "type": "string" },
        "year": { "type": "number" },
        "title": { "type": "string" },
        "vendor": { "type": "string" },
        "severity": { "type": "string" },
        "score": { "type": "number" },
        "category": { "type": "string" },
        "cisaKev": { "type": "boolean" },
        "briefing": { "type": "string" },
        "toolsUsed": { "type": "array" },
        "headHero": { "type": "string" },
        "corePoints": { "type": "string" },
        "affectedVictims": { "type": "string" },
        "attackUseCase": { "type": "string" },
        "detectionSignatures": { "type": "string" },
        "remediation": { "type": "string" },
        "nvdUrl": { "type": "string" },
        "dateAdded": { "type": "string" },
        "dueDate": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["cveId", "title"]
    },
    "UserVault": {
      "title": "UserVault",
      "description": "Isolated user vault profile and workspaces.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "workspaces": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/vault_snapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/VaultSnapshot" },
      "description": "BrainVault canvas workspace, notes, stickies, and links state"
    },
    "/api_keys/{configId}": {
      "schema": { "$ref": "#/entities/ApiKeysConfig" },
      "description": "API keys configuration for external news and intelligence feeds"
    },
    "/saved_news/{storyId}": {
      "schema": { "$ref": "#/entities/SavedNewsStory" },
      "description": "Saved news articles and threat briefings"
    },
    "/cve_catalog/{cveId}": {
      "schema": { "$ref": "#/entities/CveCatalogRecord" },
      "description": "CISA KEV and 2020-2026 weaponized CVE & malware catalog"
    },
    "/user_vaults/{userId}": {
      "schema": { "$ref": "#/entities/UserVault" },
      "description": "Multi-user vault profiles and isolated workspaces"
    }
  }
}
